# Copy to infra/.env.prod and fill in. Never commit infra/.env.prod.
# Generate every secret with: openssl rand -hex 32

# This server's public IP (used for the API base URL and CORS).
SERVER_IP=203.0.113.10

# Optional: set once you have a domain pointed at this server and TLS installed
# (apt-get install certbot python3-certbot-nginx && certbot --nginx).
# Overrides SERVER_IP everywhere. Include the scheme, no trailing slash.
# PUBLIC_ORIGIN=https://app.yourdomain.com

# Password for the 'drillex'@'localhost' MySQL user created by setup-vps.sh.
MYSQL_PASSWORD=change-me

JWT_ACCESS_SECRET=change-me-32-chars-minimum
JWT_REFRESH_SECRET=change-me-32-chars-minimum-different

# Attachments. 'local' writes to UPLOAD_DIR on this server — back it up alongside
# the database. Set 's3' plus the credentials below to use S3/R2 instead.
STORAGE_DRIVER=local
UPLOAD_DIR=/opt/drillex/uploads
# S3_ENDPOINT=
# S3_BUCKET=drillex
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

DEVICE_REGISTRATION_REQUIRED=true

# Optional — leave blank to disable
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=drillex-ops@yourdomain.com
