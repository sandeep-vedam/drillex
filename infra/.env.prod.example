# Copy to infra/.env.prod and fill in real values. Never commit infra/.env.prod.

# Point these DNS A records at your VPS's IP before running deploy.sh:
#   api.yourdomain.com  -> <VPS IP>
#   app.yourdomain.com  -> <VPS IP>
# (Any domain/registrar works — Hostinger, Namecheap, Cloudflare, etc. Caddy
#  auto-issues Let's Encrypt certs for whatever you put here.)
API_DOMAIN=api.yourdomain.com
WEB_DOMAIN=app.yourdomain.com
ACME_EMAIL=you@yourdomain.com

# Generate strong random secrets, e.g.: openssl rand -hex 32
POSTGRES_PASSWORD=change-me
JWT_ACCESS_SECRET=change-me-32-chars-minimum
JWT_REFRESH_SECRET=change-me-32-chars-minimum-different

# Object storage (MinIO, self-hosted alongside the app)
S3_ACCESS_KEY=drillex
S3_SECRET_KEY=change-me

# Optional — leave blank to disable
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=drillex-ops@yourdomain.com

DEVICE_REGISTRATION_REQUIRED=true
