# No-domain deployment (infra/docker-compose.prod-ip.yml). Copy to infra/.env.prod-ip and fill in.
# Generate strong secrets, e.g.: openssl rand -hex 32

SERVER_IP=203.0.113.10

MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
JWT_ACCESS_SECRET=change-me-32-chars-minimum
JWT_REFRESH_SECRET=change-me-32-chars-minimum-different

S3_ACCESS_KEY=drillex
S3_SECRET_KEY=change-me

DEVICE_REGISTRATION_REQUIRED=true
