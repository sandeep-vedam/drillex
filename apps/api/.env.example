DATABASE_URL=postgresql://drillex:drillex@localhost:5432/drillex?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
STORAGE_DRIVER=local
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=drillex
S3_ACCESS_KEY=drillex
S3_SECRET_KEY=drillex123
PORT=4000
UPLOAD_DIR=
PUBLIC_API_URL=http://localhost:4000

# Push (FCM HTTP v1). Leave empty to disable push; in-app notifications still work.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# Email share for reports (SRS 8.3). Leave empty to log instead of send.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=drillex-ops@example.com

# Security
DEVICE_REGISTRATION_REQUIRED=false
CORS_ORIGINS=http://localhost:3000
NODE_ENV=development
